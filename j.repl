cpu: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    genericInterruptController: gic

gic: IRQControllers.ARM_GenericInterruptController @ {
        sysbus new Bus.BusMultiRegistration { address: 0x08000000; size: 0x010000; region: "distributor" };
        sysbus new Bus.BusMultiRegistration { address: 0x08010000; size: 0x010000; region: "cpuInterface" }
    }
    architectureVersion: .GICv2


ram: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x10000000

i2c0: I2C.Cadence_I2C @ sysbus 0x09000000
    -> gic@32

/*
power: Python.PythonPeripheral @ sysbus 0x09100000
    size: 0x1000
    initable: true
    filename: "power_management.py"
*/


efuse: Python.PythonPeripheral @ sysbus 0x10100000
    size: 0x1000
    initable: true
    filename: "perh/efuse.py"


